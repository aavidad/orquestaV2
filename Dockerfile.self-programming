# syntax=docker/dockerfile:1

FROM golang:1.25.11-bookworm AS builder
ARG ORQUESTA_BUILD_COMMIT
WORKDIR /src
COPY go.mod go.sum ./
COPY modulos/orquesta-estado-vivo/testdeps/rapid ./modulos/orquesta-estado-vivo/testdeps/rapid
RUN go mod download
COPY . .
RUN test "${#ORQUESTA_BUILD_COMMIT}" -eq 40 \
    && test "$(printf '%s' "$ORQUESTA_BUILD_COMMIT" | tr -cd '0-9a-f')" = "$ORQUESTA_BUILD_COMMIT"
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath \
    -ldflags="-s -w -X main.serverRuntimeBuildCommitOverrideV0=${ORQUESTA_BUILD_COMMIT}" \
    -o /out/orquesta-server ./cmd/orquesta-server

FROM node:22-bookworm-slim AS runtime
ARG CODEX_NPM_VERSION=0.144.1
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates bash curl git iptables jq openssh-client procps python3 tmux \
    && npm install -g "@openai/codex@${CODEX_NPM_VERSION}" \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 10001 orquesta \
    && useradd --system --uid 10001 --gid 10001 --home-dir /workspace/home --create-home --shell /bin/bash orquesta \
    && install -d -o 10001 -g 10001 /workspace/home /workspace/codex-home /workspace/cache/go /workspace/go/pkg/mod \
    && git config --system --add safe.directory /workspace/project
COPY --from=golang:1.25.11-bookworm /usr/local/go /usr/local/go
RUN ln -s /usr/local/go/bin/go /usr/local/bin/go \
    && ln -s /usr/local/go/bin/gofmt /usr/local/bin/gofmt
COPY --from=builder /out/orquesta-server /usr/local/bin/orquesta-server
ENV HOME=/workspace/home \
    CODEX_HOME=/workspace/codex-home \
    GOCACHE=/workspace/cache/go \
    GOMODCACHE=/workspace/go/pkg/mod \
    PATH=/usr/local/go/bin:/usr/local/bin:/usr/bin:/bin
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/orquesta-server"]
CMD ["run"]
