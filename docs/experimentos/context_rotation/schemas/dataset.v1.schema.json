{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orquesta.context_rotation.dataset.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "experiment_ref", "manifest_sha256", "pairs", "report_review"],
  "properties": {
    "schema_version": {"const": "orquesta.context_rotation.dataset.v1"},
    "experiment_ref": {"$ref": "#/$defs/ref"},
    "manifest_sha256": {"$ref": "#/$defs/sha"},
    "pairs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pair"}},
    "report_review": {"$ref": "#/$defs/report_review"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"},
    "candidate": {"type": "string", "pattern": "^candidate-[a-f0-9]{24}$"},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["ref", "sha256"], "properties": {"ref": {"$ref": "#/$defs/ref"}, "sha256": {"$ref": "#/$defs/sha"}}},
    "usage": {"type": "object", "additionalProperties": false, "required": ["input_uncached", "output", "cache_read", "cache_write", "cost_micros"], "properties": {"input_uncached": {"type": "integer", "minimum": 0}, "output": {"type": "integer", "minimum": 0}, "cache_read": {"type": "integer", "minimum": 0}, "cache_write": {"type": "integer", "minimum": 0}, "cost_micros": {"type": "integer", "minimum": 0}}},
    "usage_by_role": {"type": "object", "additionalProperties": false, "required": ["director", "workers", "handoffs", "recoveries", "reviewers"], "properties": {"director": {"$ref": "#/$defs/usage"}, "workers": {"$ref": "#/$defs/usage"}, "handoffs": {"$ref": "#/$defs/usage"}, "recoveries": {"$ref": "#/$defs/usage"}, "reviewers": {"$ref": "#/$defs/usage"}}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["duration_ms", "tool_calls", "repeated_reads", "reworks", "failed_attempts", "write_set_conflicts", "human_interventions", "changed_lines", "changed_files"], "properties": {"duration_ms": {"type": "integer", "minimum": 0}, "tool_calls": {"type": "integer", "minimum": 0}, "repeated_reads": {"type": "integer", "minimum": 0}, "reworks": {"type": "integer", "minimum": 0}, "failed_attempts": {"type": "integer", "minimum": 0}, "write_set_conflicts": {"type": "integer", "minimum": 0}, "human_interventions": {"type": "integer", "minimum": 0}, "changed_lines": {"type": "integer", "minimum": 0}, "changed_files": {"type": "integer", "minimum": 0}}},
    "test": {"type": "object", "additionalProperties": false, "required": ["command", "executed", "passed", "evidence"], "properties": {"command": {"type": "string", "minLength": 1}, "executed": {"type": "boolean"}, "passed": {"type": "boolean"}, "evidence": {"$ref": "#/$defs/evidence"}}},
    "handoff": {"type": "object", "additionalProperties": false, "required": ["stage_ref", "package", "continued_from_package_and_refs", "requested_raw_transcript", "out_of_scope_reads"], "properties": {"stage_ref": {"$ref": "#/$defs/ref"}, "package": {"$ref": "#/$defs/evidence"}, "continued_from_package_and_refs": {"type": "boolean"}, "requested_raw_transcript": {"type": "boolean"}, "out_of_scope_reads": {"type": "integer", "minimum": 0}}},
    "independent_review": {"type": "object", "additionalProperties": false, "required": ["completed", "accepted", "candidate_ref", "quality_score", "unnecessary_changed_lines", "evidence"], "properties": {"completed": {"type": "boolean"}, "accepted": {"type": "boolean"}, "candidate_ref": {"$ref": "#/$defs/candidate"}, "quality_score": {"type": "integer", "minimum": 0, "maximum": 100}, "unnecessary_changed_lines": {"type": "integer", "minimum": 0}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}}},
    "arm": {"type": "object", "additionalProperties": false, "required": ["mode", "candidate_ref", "blind_candidate_ref", "status", "config_sha256", "usage_by_role", "metrics", "false_green", "causal_loss", "unauthorized_external_effects", "external_effects", "severe_defects", "tests", "handoffs", "independent_review", "diff", "artifacts", "receipts"], "properties": {"mode": {"enum": ["control", "treatment"]}, "candidate_ref": {"$ref": "#/$defs/ref"}, "blind_candidate_ref": {"$ref": "#/$defs/candidate"}, "status": {"const": "completed"}, "config_sha256": {"$ref": "#/$defs/sha"}, "usage_by_role": {"$ref": "#/$defs/usage_by_role"}, "metrics": {"$ref": "#/$defs/metrics"}, "false_green": {"type": "boolean"}, "causal_loss": {"type": "boolean"}, "unauthorized_external_effects": {"type": "boolean"}, "external_effects": {"type": "integer", "minimum": 0}, "severe_defects": {"type": "integer", "minimum": 0}, "tests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/test"}}, "handoffs": {"type": "array", "items": {"$ref": "#/$defs/handoff"}}, "independent_review": {"$ref": "#/$defs/independent_review"}, "diff": {"$ref": "#/$defs/evidence"}, "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}, "receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}}},
    "pair": {"type": "object", "additionalProperties": false, "required": ["pair_ref", "arms"], "properties": {"pair_ref": {"$ref": "#/$defs/ref"}, "arms": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/arm"}}}},
    "report_review": {"type": "object", "additionalProperties": false, "required": ["completed", "accepted", "reproduction_passed", "evidence"], "properties": {"completed": {"type": "boolean"}, "accepted": {"type": "boolean"}, "reproduction_passed": {"type": "boolean"}, "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}}}
  }
}
