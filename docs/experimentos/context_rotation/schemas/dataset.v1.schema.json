{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orquesta.context_rotation.dataset.v1",
  "type": "object",
  "required": ["schema_version", "experiment_ref", "manifest_sha256", "pairs", "report_review"],
  "properties": {
    "schema_version": {"const": "orquesta.context_rotation.dataset.v1"},
    "experiment_ref": {"type": "string"},
    "manifest_sha256": {"$ref": "#/$defs/sha"},
    "pairs": {"type": "array", "items": {"type": "object", "required": ["pair_ref", "arms"], "properties": {"pair_ref": {"type": "string"}, "arms": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/arm"}}}}},
    "report_review": {"type": "object", "required": ["completed", "accepted", "reproduction_passed", "evidence"]}
  },
  "additionalProperties": false,
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {"type": "object", "required": ["ref", "sha256"], "properties": {"ref": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha"}}, "additionalProperties": false},
    "usage": {"type": "object", "required": ["input_uncached", "output", "cache_read", "cache_write", "cost_micros"], "properties": {"input_uncached": {"type": "integer", "minimum": 0}, "output": {"type": "integer", "minimum": 0}, "cache_read": {"type": "integer", "minimum": 0}, "cache_write": {"type": "integer", "minimum": 0}, "cost_micros": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "arm": {"type": "object", "required": ["mode", "candidate_ref", "status", "config_sha256", "usage_by_role", "metrics", "false_green", "causal_loss", "unauthorized_external_effects", "external_effects", "severe_defects", "tests", "handoffs", "independent_review", "diff", "artifacts", "receipts"], "properties": {"mode": {"enum": ["control", "treatment"]}, "candidate_ref": {"type": "string"}, "status": {"const": "completed"}, "config_sha256": {"$ref": "#/$defs/sha"}, "usage_by_role": {"type": "object", "required": ["director", "workers", "handoffs", "recoveries", "reviewers"], "additionalProperties": {"$ref": "#/$defs/usage"}}, "metrics": {"type": "object"}, "false_green": {"type": "boolean"}, "causal_loss": {"type": "boolean"}, "unauthorized_external_effects": {"type": "boolean"}, "external_effects": {"type": "integer", "minimum": 0}, "severe_defects": {"type": "integer", "minimum": 0}, "tests": {"type": "array"}, "handoffs": {"type": "array"}, "independent_review": {"type": "object"}, "diff": {"$ref": "#/$defs/evidence"}, "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}, "receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}}, "additionalProperties": false}
  }
}
