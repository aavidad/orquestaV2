{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orquesta.context_rotation.manifest.v1",
  "type": "object",
  "required": ["schema_version", "experiment_ref", "repository_path", "baseline_commit", "snapshot", "temporary_root", "state_root", "execution", "reviewer", "retention", "pairs"],
  "properties": {
    "schema_version": {"const": "orquesta.context_rotation.manifest.v1"},
    "experiment_ref": {"$ref": "#/$defs/ref"},
    "repository_path": {"type": "string", "minLength": 1},
    "baseline_commit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "snapshot": {"$ref": "#/$defs/evidence"},
    "temporary_root": {"type": "string", "pattern": "^/"},
    "state_root": {"type": "string", "pattern": "^/"},
    "execution": {"$ref": "#/$defs/config"},
    "reviewer": {"allOf": [{"$ref": "#/$defs/config"}, {"type": "object", "required": ["blinded", "fresh_context", "blinding_key_sha256", "reproduction_test"], "properties": {"blinded": {"const": true}, "fresh_context": {"const": true}, "blinding_key_sha256": {"$ref": "#/$defs/sha"}, "reproduction_test": {"type": "string", "minLength": 1}}}]},
    "retention": {"type": "object", "additionalProperties": false, "required": ["allow_worktree_cleanup", "preserve_receipts", "minimum_retention_hours"], "properties": {"allow_worktree_cleanup": {"type": "boolean"}, "preserve_receipts": {"const": true}, "minimum_retention_hours": {"type": "integer", "minimum": 1, "maximum": 8760}}},
    "pairs": {"type": "array", "minItems": 3, "maxItems": 20, "items": {"$ref": "#/$defs/pair"}}
  },
  "additionalProperties": false,
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}$"},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["ref", "sha256"], "properties": {"ref": {"$ref": "#/$defs/ref"}, "sha256": {"$ref": "#/$defs/sha"}}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["max_total_tokens", "max_cost_micros", "max_duration_ms", "max_tool_calls", "max_handoff_tokens", "max_workspace_bytes"], "properties": {"max_total_tokens": {"type": "integer", "minimum": 1}, "max_cost_micros": {"type": "integer", "minimum": 1}, "max_duration_ms": {"type": "integer", "minimum": 1}, "max_tool_calls": {"type": "integer", "minimum": 1}, "max_handoff_tokens": {"type": "integer", "minimum": 1}, "max_workspace_bytes": {"type": "integer", "minimum": 1}}},
    "config": {"type": "object", "required": ["model", "effort", "tools", "budget"], "properties": {"model": {"type": "string", "minLength": 1}, "effort": {"type": "string", "minLength": 1}, "tools": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "budget": {"$ref": "#/$defs/budget"}}},
    "stage": {"type": "object", "additionalProperties": false, "required": ["stage_ref", "objective", "cause", "write_set", "context_refs"], "properties": {"stage_ref": {"$ref": "#/$defs/ref"}, "objective": {"type": "string", "minLength": 1}, "cause": {"type": "string", "minLength": 1}, "write_set": {"type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "context_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}}},
    "pair": {"type": "object", "additionalProperties": false, "required": ["pair_ref", "objective", "write_set", "acceptance_criteria", "required_tests", "context_refs", "treatment_stages"], "properties": {"pair_ref": {"$ref": "#/$defs/ref"}, "objective": {"type": "string", "minLength": 1}, "write_set": {"type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "required_tests": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "context_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}, "treatment_stages": {"type": "array", "minItems": 2, "maxItems": 20, "items": {"$ref": "#/$defs/stage"}}}}
  }
}
