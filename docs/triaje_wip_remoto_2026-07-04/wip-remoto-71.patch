+goal_state_summary_response() {
+  local run_ref="$1"
+  local output_file="$2"
+  python3 - "$state_dir" "$run_ref" "$output_file" <<'PY'
+import json
+import sys
+from pathlib import Path
+
+state_dir = Path(sys.argv[1])
+run_ref = sys.argv[2].strip()
+output_file = Path(sys.argv[3])
+goal_dir = state_dir / "orchestration-state" / "app_director_goal_states"
+run_dir = state_dir / "orchestration-state" / "runs"
+goal_state = None
+if goal_dir.exists():
+    for path in sorted(goal_dir.glob("*.json")):
+        try:
+            data = json.loads(path.read_text(encoding="utf-8"))
+        except Exception:
+            continue
+        state = data.get("state") if isinstance(data, dict) else None
+        if isinstance(state, dict) and str(state.get("run_ref", "")).strip() == run_ref:
+            goal_state = state
+            break
+if goal_state is None:
+    sys.exit(1)
+run_status = ""
+if run_dir.exists():
+    for path in sorted(run_dir.glob("*.json")):
+        try:
+            data = json.loads(path.read_text(encoding="utf-8"))
+        except Exception:
+            continue
+        run = data.get("run") if isinstance(data, dict) else None
+        if isinstance(run, dict) and str(run.get("run_id", "")).strip() == run_ref:
+            run_status = str(run.get("status", "")).strip()
+            break
+last_result = goal_state.get("last_result") if isinstance(goal_state.get("last_result"), dict) else {}
+last_closure = goal_state.get("last_closure") if isinstance(goal_state.get("last_closure"), dict) else {}
+response = {
+    "estado": "ok",
+    "run_ref": run_ref,
+    "run_status": run_status,
+    "director_execution_mode": "goal_first",
+    "goal_ref": str(goal_state.get("goal_ref", "")).strip(),
+    "external_goal_ref": str(goal_state.get("external_goal_ref", "")).strip(),
+    "goal_status": str(goal_state.get("status", "")).strip(),
+    "closure_status": str(last_closure.get("status", "")).strip(),
+    "closure_accepted": bool(last_closure.get("accepted", False)),
+    "closure_needs_rework": bool(last_closure.get("needs_rework", False)),
+    "summary": str(last_result.get("summary", "")).strip(),
+    "artifact_refs": last_result.get("artifact_refs", []) if isinstance(last_result.get("artifact_refs"), list) else [],
+    "domain_receipt_refs": last_result.get("domain_receipt_refs", []) if isinstance(last_result.get("domain_receipt_refs"), list) else [],
+    "evidence_refs": goal_state.get("evidence_refs", []) if isinstance(goal_state.get("evidence_refs"), list) else [],
+}
+output_file.write_text(json.dumps(response, ensure_ascii=False) + "\n", encoding="utf-8")
+PY
+}
