ORQUESTA_SERVER_SELF_PROGRAMMING_ONLY=true
ORQUESTA_SERVER_SELF_PROGRAMMING_ROOT=/workspace
# Bind interno del contenedor. La frontera externa debe seguir siendo loopback
# en docker-compose (`127.0.0.1:19039:19039`), no puerto publico.
# No usar este env suelto fuera del compose aislado sin cambiar a 127.0.0.1.
ORQUESTA_SERVER_ADDR=0.0.0.0:19039
ORQUESTA_SERVER_REMOTE_CONTROL_PLANE_CONFIRM=true
# Generar antes de arrancar: openssl rand -hex 32
ORQUESTA_SERVER_CONTROL_TOKEN=
ORQUESTA_SERVER_CONTROL_PRINCIPAL=orquesta-self-operator
ORQUESTA_SERVER_CONTROL_PERMISSION_REF=permission-ref-orquesta-self-loopback
ORQUESTA_SERVER_CONTROL_PUBLIC_REASON=self_programming_ssh_tunnel_only

ORQUESTA_CODEX_PROJECT_WORKDIR=/workspace/project
ORQUESTA_CODEX_RUNTIME_WORKDIR=/workspace/runtime
ORQUESTA_SERVER_STATE_DIR=/workspace/state
ORQUESTA_CODEX_GOAL_BACKEND=app_server_tmux
ORQUESTA_CODEX_GOAL_TIMEOUT_MS=900000
ORQUESTA_CODEX_GOAL_PREFLIGHT_TIMEOUT_MS=10000
ORQUESTA_CODEX_SANDBOX=workspace-write
ORQUESTA_CODEX_APPROVAL_POLICY=never
ORQUESTA_CODEX_REASONING_EFFORT=medium

ORQUESTA_SERVER_RESIDENT_DIRECTOR_ENABLED=false
ORQUESTA_SERVER_GOAL_OBSERVER_ENABLED=true
ORQUESTA_SERVER_GOAL_OBSERVER_INTERVAL_MS=5000
ORQUESTA_SERVER_IDLE_SELF_IMPROVEMENT_GOAL_FIRST_ENABLED=true
ORQUESTA_SERVER_IDLE_SELF_IMPROVEMENT_AFTER_SECONDS=60
ORQUESTA_SERVER_IDLE_SELF_IMPROVEMENT_PROJECT_WORKDIR=/workspace/project
ORQUESTA_SERVER_IDLE_SELF_IMPROVEMENT_REQUIRED_TESTS=go test -count=1 ./cmd/orquesta-server ./modulos/orquesta-runtime-codex-goal ./modulos/orquesta-goal
ORQUESTA_SERVER_IDLE_SELF_IMPROVEMENT_CONTEXT_REFS=AGENTS.md,docs/estado_actual_2026-05-17.md,docs/orquesta_goal_first_codex_2026-06-25.md,deploy/self-programming/goal_context.md
ORQUESTA_SERVER_IDLE_SELF_IMPROVEMENT_ACCEPTANCE=solo repo Orquesta,no produccion,no OPES productivo,no stdio,app_server_tmux obligatorio,pruebas aisladas conservadas
ORQUESTA_SERVER_IDLE_SELF_IMPROVEMENT_COMPACT_RULES=comunicacion compacta,conservar artefactos de prueba,no promocionar produccion
ORQUESTA_SERVER_IDLE_SELF_IMPROVEMENT_MAX_REQUESTS=1
ORQUESTA_SERVER_IDLE_SELF_IMPROVEMENT_TARGET_QUEUE=1
ORQUESTA_SERVER_MAX_RUNS_PER_TICK=1
ORQUESTA_SERVER_MAX_EXECUTIONS_PER_TICK=1
ORQUESTA_SERVER_QUEUE_LIMIT=1
ORQUESTA_SERVER_DRAIN_MAX_DISPATCHES=1
ORQUESTA_SERVER_DRAIN_MAX_OUTBOX=1
ORQUESTA_SERVER_DRAIN_MAX_EXTERNAL_WAITS=1

ORQUESTA_OPES_BASE_URL=
OPES_BASE_URL=
ORQUESTA_OPES_BRIDGE_ENABLED=false
ORQUESTA_OPES_BRIDGE_CONFIRM=false
# Dry-run OPES queda en su default seguro. No declararlo aqui: una variable
# OPES explicita, aunque sea segura, marca sesion de dominio y pausa idle
# self-improvement.
ORQUESTA_OPES_REGISTRY_FINALPKG_ENABLED=false
ORQUESTA_OPES_REGISTRY_FINALPKG_CONFIRM=false
ORQUESTA_OPES_REGISTRY_FINALPKG_REGISTRY_PATH=
ORQUESTA_OPES_REGISTRY_FINALPKG_COURSE_ROOT=
ORQUESTA_OPES_TOPIC_REGISTRY_ENABLED=false
ORQUESTA_OPES_TOPIC_REGISTRY_TOOL_PATH=
ORQUESTA_DOMAIN_WORK_HTTP_BASE_URL=
ORQUESTA_DOMAIN_WORK_FILE_ENABLED=false
