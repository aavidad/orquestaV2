{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orquesta.local/schemas/rebuild-traceability-v1.json",
  "title": "Orquesta rebuild traceability ledger",
  "oneOf": [
    {
      "$ref": "#/$defs/legacyGoLedger"
    },
    {
      "$ref": "#/$defs/pendingSourceLedger"
    }
  ],
  "$defs": {
    "capabilityId": {
      "type": "string",
      "pattern": "^(GOV|WIZ|STG|ORC|EVD|UI|AGT|EXT|OPE|OPS|TLS|CTX|APP)-[0-9]{2}$"
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module_count",
        "package_count",
        "production_file_count",
        "symbol_count",
        "module_set_sha256",
        "census_sha256"
      ],
      "properties": {
        "module_count": {"type": "integer", "minimum": 0},
        "package_count": {"type": "integer", "minimum": 0},
        "production_file_count": {"type": "integer", "minimum": 0},
        "symbol_count": {"type": "integer", "minimum": 0},
        "module_set_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "census_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "moduleRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "paths",
        "disposition",
        "capability_ids",
        "reason",
        "characterization_required"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^modulos/orquesta-[a-z0-9-]+$"}
        },
        "disposition": {"enum": ["supersede", "retire"]},
        "capability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/capabilityId"}
        },
        "reason": {"type": "string", "minLength": 20},
        "characterization_required": {"const": true}
      }
    },
    "legacyGoLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_kind",
        "schema_version",
        "source_root",
        "source_policy",
        "baseline",
        "module_rules"
      ],
      "properties": {
        "document_kind": {"const": "legacy_go_census"},
        "schema_version": {"const": 1},
        "source_root": {"const": "modulos"},
        "source_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include", "exclude_test_suffix", "exact_exclusions", "symbol_kinds"],
          "properties": {
            "include": {"const": "all_descendant_go_files_of_exact_module_paths"},
            "exclude_test_suffix": {"const": "_test.go"},
            "exact_exclusions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "kind", "reason"],
                "properties": {
                  "path": {"type": "string"},
                  "kind": {"enum": ["file", "subtree"]},
                  "reason": {"type": "string", "minLength": 20}
                }
              }
            },
            "symbol_kinds": {
              "const": ["const", "var", "type", "func", "method"]
            }
          }
        },
        "baseline": {"$ref": "#/$defs/baseline"},
        "module_rules": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/moduleRule"}
        }
      }
    },
    "sourceRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "status",
        "exact_paths",
        "path_patterns",
        "expected_file_count",
        "manifest_sha256",
        "next_gate"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
        "kind": {"enum": ["task", "bug", "skill", "rulepack"]},
        "status": {"enum": ["inventory_only_pending_disposition", "absent_pending_contract"]},
        "exact_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "path_patterns": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "expected_file_count": {"type": "integer", "minimum": 0},
        "manifest_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "next_gate": {"type": "string", "minLength": 20}
      }
    },
    "pendingSourceLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_kind", "schema_version", "sources"],
      "properties": {
        "document_kind": {"const": "pending_source_inventory"},
        "schema_version": {"const": 1},
        "sources": {
          "type": "array",
          "minItems": 4,
          "items": {"$ref": "#/$defs/sourceRange"}
        }
      }
    }
  }
}
