    "occurrence_ref_subject": "bug_id_newline_raw_bug_ref_newline_component_index_newline_source_ref_newline_source_line_newline_source_column_newline_text_sha256",
    "entry_ref_subject": "source_ref_newline_source_line_newline_text_sha256"
  },
  "capability_authority": "product/roadmap.json#capability_entries",
  "closure_policy": "historical_status_and_cited_tests_never_imply_rebuild_closure",
