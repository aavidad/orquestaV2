{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://orquesta.local/orquesta-i18n-docs/schemas/app_i18n_docs_plan_v0.schema.json",
  "title": "AppI18nDocsPlanV0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "app_id_hint",
    "source_contract",
    "ui_default_locale",
    "docs_default_locale",
    "skeleton_loader_shape",
    "warnings"
  ],
  "properties": {
    "contract_version": {
      "const": "v0"
    },
    "app_id_hint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "source_contract": {
      "const": "AppSpecV0"
    },
    "ui_default_locale": {
      "$ref": "#/$defs/locale"
    },
    "docs_default_locale": {
      "$ref": "#/$defs/locale"
    },
    "web_bundle": {
      "$ref": "i18n_bundle_v0.schema.json"
    },
    "factory_bundle": {
      "$ref": "i18n_bundle_v0.schema.json"
    },
    "docs_bundle": {
      "$ref": "docs_bundle_v0.schema.json"
    },
    "skeleton_loader_shape": {
      "$ref": "#/$defs/skeleton_loader_shape"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "web_bundle"
      ]
    },
    {
      "required": [
        "factory_bundle"
      ]
    },
    {
      "required": [
        "docs_bundle"
      ]
    }
  ],
  "$defs": {
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)*$"
    },
    "message_key": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180,
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9]+)+$"
    },
    "skeleton_loader_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structure_version",
        "loader_contract",
        "catalog_path_pattern",
        "default_locale_strategy",
        "fallback_locale",
        "required_namespaces",
        "required_keys_hash"
      ],
      "properties": {
        "structure_version": {
          "const": "i18n-bundle/v0"
        },
        "loader_contract": {
          "const": "i18n-loader/v0"
        },
        "catalog_path_pattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*://)[A-Za-z0-9._{}/-]+$"
        },
        "default_locale_strategy": {
          "type": "string",
          "enum": [
            "app_spec",
            "explicit"
          ]
        },
        "fallback_locale": {
          "$ref": "#/$defs/locale"
        },
        "required_namespaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/namespace"
          },
          "uniqueItems": true
        },
        "required_keys_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message_key"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message_key": {
          "$ref": "#/$defs/message_key"
        }
      }
    }
  }
}
