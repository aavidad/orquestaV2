{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orquesta.local/orquesta-factory/schemas/app_spec_request_v0.schema.json",
  "title": "AppSpecRequestV0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "source",
    "locale",
    "nombre",
    "objetivo",
    "tipo_app"
  ],
  "properties": {
    "schema_version": {
      "const": "app_spec_request.v0"
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "source": {
      "type": "string",
      "enum": [
        "orquesta-web",
        "orquesta-mcp",
        "orquesta-cli"
      ]
    },
    "locale": {
      "$ref": "#/$defs/locale"
    },
    "request_kind": {
      "type": "string",
      "default": "crear_app_completa",
      "enum": [
        "documentar_app",
        "analizar_app",
        "brainstorming_arquitectura",
        "planificar_app",
        "crear_app_completa",
        "programar_modulo",
        "modificar_app_existente",
        "revisar_codigo",
        "pruebas_y_validacion",
        "seguridad",
        "deploy",
        "operacion_soporte",
        "integracion_externa",
        "i18n_l10n",
        "migracion_refactor",
        "investigacion_tecnica"
      ]
    },
    "execution_mode": {
      "type": "string",
      "default": "normal",
      "enum": [
        "normal",
        "debug"
      ]
    },
    "project_source": {
      "$ref": "#/$defs/project_source_request"
    },
    "nombre": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "objetivo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "descripcion": {
      "type": "string",
      "maxLength": 4000
    },
    "tipo_app": {
      "type": "string",
      "enum": [
        "web",
        "api",
        "cli",
        "desktop",
        "mobile",
        "automation",
        "data",
        "plugin",
        "mixed",
        "documentacion",
        "documentation"
      ]
    },
    "usuarios_objetivo": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true
    },
    "plataformas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "uniqueItems": true
    },
    "integraciones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/connector_request"
      }
    },
    "preferencias_tecnicas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lenguaje": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "framework": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "arquitectura": {
          "description": "Patron arquitectonico preferido. Orquesta conserva fronteras limpias aunque el patron no sea hexagonal.",
          "type": "string",
          "enum": [
            "hexagonal",
            "clean_architecture",
            "onion",
            "modular_monolith",
            "layered",
            "event_driven",
            "microservices",
            "serverless",
            "plugin_based",
            "data_pipeline"
          ],
          "default": "hexagonal"
        },
        "restricciones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        },
        "preferencias": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "datos": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "db_required": {
          "type": "boolean",
          "default": false
        },
        "necesidad_funcional": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "tipos_datos": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "uniqueItems": true
        },
        "tipos_detallados": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data_type_request"
          }
        },
        "storage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/data_storage_request"
          }
        },
        "sensibilidad": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "retencion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "db_required": {
                "const": true
              }
            },
            "required": [
              "db_required"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "necesidad_funcional"
                ]
              },
              {
                "required": [
                  "tipos_detallados"
                ]
              },
              {
                "required": [
                  "storage"
                ]
              }
            ]
          }
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "provider"
                ]
              },
              {
                "required": [
                  "db_provider"
                ]
              },
              {
                "required": [
                  "dialect"
                ]
              },
              {
                "required": [
                  "tables"
                ]
              },
              {
                "required": [
                  "sql"
                ]
              },
              {
                "required": [
                  "connection_string"
                ]
              }
            ]
          }
        }
      ]
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "sin_preferencia",
            "local",
            "contenedor",
            "paas",
            "serverless",
            "kubernetes",
            "desktop",
            "mobile_store"
          ]
        },
        "restricciones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "calidad": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pruebas": {
          "type": "string",
          "enum": [
            "basica",
            "media",
            "alta"
          ]
        },
        "accesibilidad": {
          "type": "string",
          "enum": [
            "no_aplica",
            "basica",
            "normal",
            "wcag_aa"
          ]
        },
        "accesibilidad_opciones": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "no_aplica",
              "basica",
              "normal",
              "wcag_aa"
            ]
          },
          "uniqueItems": true
        },
        "compliance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "uniqueItems": true
        },
        "observabilidad": {
          "type": "boolean"
        }
      }
    },
    "documentacion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "usuario": {
          "type": "boolean",
          "default": true
        },
        "desarrollo": {
          "type": "boolean",
          "default": true
        },
        "sistemas": {
          "type": "boolean",
          "default": true
        },
        "profundidad": {
          "type": "string",
          "enum": [
            "basica",
            "normal",
            "profunda"
          ],
          "default": "profunda"
        },
        "locales": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locale"
          },
          "uniqueItems": true
        }
      }
    },
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "default_locale": {
          "$ref": "#/$defs/locale"
        },
        "locales": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locale"
          },
          "uniqueItems": true
        },
        "justificacion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": false
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "justificacion"
            ]
          }
        }
      ]
    },
    "agentes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision_humana": {
          "type": "boolean"
        },
        "autonomia": {
          "type": "string",
          "enum": [
            "baja",
            "media",
            "alta"
          ]
        },
        "preferencias": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "restricciones": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    }
  },
  "$defs": {
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "project_source_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "default": "new",
          "enum": [
            "new",
            "github",
            "local_path"
          ]
        },
        "git_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "local_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "project_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "not": {
        "required": [
          "git_url",
          "local_path"
        ]
      }
    },
    "connector_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nombre",
        "proposito"
      ],
      "properties": {
        "tipo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "nombre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "not": {
            "enum": [
              "postgres",
              "postgresql",
              "mysql",
              "sqlite",
              "mongodb",
              "redis"
            ]
          }
        },
        "proposito": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "requerido": {
          "type": "boolean",
          "default": true
        },
        "restricciones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "data_type_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nombre": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "proposito": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sensibilidad": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "retencion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "volumen": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "restricciones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    },
    "data_storage_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "type": "string",
          "enum": [
            "sin_preferencia",
            "sin_persistencia",
            "relacional",
            "documental",
            "vectorial",
            "objetos",
            "objetos_blob",
            "clave_valor",
            "clave_valor_cache",
            "series_temporales",
            "grafo",
            "cache",
            "busqueda",
            "eventos_auditoria",
            "mixta"
          ]
        },
        "proposito": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "requerido": {
          "type": "boolean",
          "default": false
        },
        "restricciones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    }
  }
}
