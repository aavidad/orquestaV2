[server]
listen = "127.0.0.1:8080"
mcp_path = "/mcp"
max_request_bytes = 1048576
read_timeout = "15s"
write_timeout = "30s"
idle_timeout = "60s"
shutdown_timeout = "15s"

[state.sqlite]
path = "./var/state/orquesta.sqlite"
busy_timeout = "5s"
max_open_connections = 8

[artifact.filesystem]
root = "./var/artifacts"

[credentials.local]
path = "./var/secrets/credentials.json"
max_document_bytes = 1048576

[runtime]
provider = "codex"
max_output_bytes = 1048576

[runtime.codex]
command = "codex"
model = ""
reasoning = "medium"
timeout = "30m"
process_pipe_drain_delay = "250ms"
supervisor_start_timeout = "1s"
max_diagnostic_bytes = 65536
max_concurrent_executions = 70
work_root = "./var/work"
cache_root = "./var/cache/codex-go"
go_toolchain_root = ""
cgroup_root = ""
env_allowlist = ["PATH", "HOME", "CODEX_HOME"]
account_home_root = ""
account_profile = ""
account_auth_max_document_bytes = 1048576
mcp_bearer_token_env_var = "ORQUESTA_MCP_BEARER_TOKEN"
credential_ref = ""

[agent.firecracker.vsock_cid]
minimum_lease_duration = "5s"
maximum_lease_duration = "1h"

[workspace.local]
root = "./var/workspaces"

[repository.local]
seed_path = ""
target_ref = "refs/heads/main"

[test_attestor]
provider = "disabled"
max_subject_bytes = 536870912
timeout = "15m"
max_concurrent_runs = 2

[test_attestor.bubblewrap]
command = ""

[test_attestor.microvm]
launcher_socket = ""
expected_asset_digest = ""
guest_memory_mib = 4096

[test_attestor.go]
toolchain_root = ""

[test_attestor.resources]
cgroup_root = ""
memory_max_bytes = 5368709120
pids_max = 512
cpu_quota_micros = 200000

[identity]
provider = "local_token"
local_actor = "actor:local-owner"
local_token_path = "./var/secrets/local-owner.token"

[identity.oidc]
issuer = ""
audience = ""
required_groups = []
clock_skew = "30s"
upstream_timeout = "10s"

[project]
default = "project:default"

[governance]
budget_currency = "USD"
global_token_budget = 14000000
global_money_micros_budget = 70000000
default_execution_token_budget = 200000
default_execution_money_micros_budget = 1000000
effect_approval_ttl = "24h"

[director]
lease_duration = "2m"

[intake]
max_question_rounds = 6

[mailbox]
max_envelope_bytes = 65536

[scheduler]
poll_interval = "500ms"
observation_interval = "2s"
claim_lease = "2m"
attest_test_claim_lease = "20m"
max_execution_attempts = 3
max_children_per_parent = 6
execution_timeout = "45m"

[api]
max_list_limit = 100
locale = "es"

[config]
effective_path = "./var/effective_config.json"
effective_max_existing_bytes = 16777216
