[Unit]
Description=Orquesta - Agente Vigilante (antigravity)
Documentation=https://github.com/OSL-Granada/orquestador
After=network.target orquesta.service
Wants=orquesta.service

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__ROOT_DIR__
ExecStart=/bin/bash __ROOT_DIR__/scripts/vigilante.sh orquestador
Restart=always
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orquesta-vigilante
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__ROOT_DIR__

[Install]
WantedBy=multi-user.target
