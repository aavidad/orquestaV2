[Unit]
Description=Orquesta - Respaldo verificado SQLite (rescate automatizado)
Documentation=https://github.com/OSL-Granada/orquestador
After=local-fs.target

[Service]
Type=oneshot
User=__USER__
Group=__USER__
WorkingDirectory=__ROOT_DIR__
ExecStart=/bin/bash __ROOT_DIR__/scripts/backup_bd.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orquesta-backup-sqlite
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__ROOT_DIR__ /home/__USER__/Trabajo/backups/orquestador

[Install]
WantedBy=multi-user.target
