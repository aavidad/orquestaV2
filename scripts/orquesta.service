[Unit]
Description=Orquesta - Control Plane de Agentes IA
Documentation=https://github.com/OSL-Granada/orquestador
After=network.target
Wants=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__ROOT_DIR__
EnvironmentFile=-__ROOT_DIR__/.orquesta.env
ExecStart=__ROOT_DIR__/orquesta serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=mixed
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orquesta
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
ReadWritePaths=__ROOT_DIR__

[Install]
WantedBy=multi-user.target
