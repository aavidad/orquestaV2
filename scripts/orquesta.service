[Unit]
Description=Orquesta - Control Plane de Agentes IA
Documentation=https://github.com/OSL-Granada/orquestador
After=network.target
Wants=network.target

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=__ROOT_DIR__
ExecStart=__ROOT_DIR__/orquesta serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=orquesta
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__ROOT_DIR__

[Install]
WantedBy=multi-user.target
