[Unit]
Description=Orquesta Control Plane Daemon
After=network.target

[Service]
Type=simple
User=alberto
WorkingDirectory=/home/alberto/Trabajo/orquesta
Environment=ORQUESTA_REQUIRE_EXPLICIT_PERSISTENCE=1
EnvironmentFile=-/home/alberto/Trabajo/orquesta/orquesta.env
ExecStart=/home/alberto/Trabajo/orquesta/orquesta serve --puerto 16543
Restart=always
RestartSec=10
StandardOutput=append:/home/alberto/Trabajo/orquesta/logs/daemon.log
StandardError=append:/home/alberto/Trabajo/orquesta/logs/daemon.err

[Install]
WantedBy=multi-user.target
